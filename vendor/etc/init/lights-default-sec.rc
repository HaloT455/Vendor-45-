service vendor.samsung.hardware.light-default /vendor/bin/hw/vendor.samsung.hardware.light-service
    class hal
    user system
    group system

# S8+ LED compatibility test: grant access before the HAL probes its nodes.
# Keep Samsung's AIDL service and ISehLights extension unchanged.
# Nodes verified against the supplied dream2lte LineageOS vendor.
on post-fs
    chown system system /sys/class/sec/led/led_pattern
    chmod 0664 /sys/class/sec/led/led_pattern
    chown system system /sys/class/sec/led/led_blink
    chmod 0664 /sys/class/sec/led/led_blink

on post-fs-data
    chown system system /sys/class/sec/led/led_pattern
    chmod 0664 /sys/class/sec/led/led_pattern
    chown system system /sys/class/sec/led/led_blink
    chmod 0664 /sys/class/sec/led/led_blink
